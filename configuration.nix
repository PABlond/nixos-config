# Entry point for host `nixos`.
#
# This file holds imports only; all configuration lives in modules/.
# To find an option, look for the module whose name matches its domain.

{ ... }:

{
  imports = [
    # Generated by nixos-generate-config -- do not hand-edit.
    ./hardware-configuration.nix

    ./modules/nix.nix
    ./modules/boot.nix
    ./modules/locale.nix
    ./modules/networking.nix
    ./modules/nvidia.nix
    # Sway is the desktop; desktop-i3.nix is a rescue session, not a second
    # daily environment. See the header of each file.
    ./modules/desktop-sway.nix
    ./modules/desktop-i3.nix
    ./modules/fonts.nix
    ./modules/audio.nix
    ./modules/coredump.nix
    ./modules/users.nix

    # User-level config (dotfiles). Needs home-manager.nixosModules.home-manager
    # to be in the flake's module list -- see flake.nix.
    ./modules/home.nix
    ./modules/shell.nix
    ./modules/packages.nix
    ./modules/services.nix
    ./modules/virtualisation.nix
  ];

  # NixOS version at first install on this machine. Keeps application data
  # compatible -- NEVER change it, not even after an upgrade.
  # See `man configuration.nix`.
  system.stateVersion = "26.05";
}
